local Mercury = loadstring(game:HttpGet("https://raw.githubusercontent.com/deeeity/mercury-lib/master/src.lua"))()

local GUI = Mercury:Create{
    Name = "AdonisK1ller by xz03404",
    Size = UDim2.fromOffset(600, 400),
    Theme = Mercury.Themes.Dark,
    Link = "https://github.com/deeeity/mercury-lib"
}

local function silentExecuteCommand(command)
    local prefix = ":"
    local textbox = game.Players.LocalPlayer.PlayerGui:FindFirstChild("PlayerList", true).Parent:FindFirstChildOfClass("TextBox")
    if textbox then
        textbox:CaptureFocus()
        textbox.Text = prefix .. command
        textbox:ReleaseFocus(true)
    end
end

